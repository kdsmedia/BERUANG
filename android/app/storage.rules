rules_version = '2';
// BERUANG — Storage Security Rules (mirror of the Supabase storage policies)
// Deploy: firebase deploy --only storage
// Buckets: "posts" and "avatars", uploads must be under a folder named by the user's uid.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    // posts/{uid}/...
    match /posts/{uid}/{allPaths=**} {
      allow read: if true;
      allow create: if signedIn() && uid == me();
      allow delete: if signedIn() && uid == me();
    }

    // avatars/{uid}/...
    match /avatars/{uid}/{allPaths=**} {
      allow read: if true;
      allow create: if signedIn() && uid == me();
      allow delete: if signedIn() && uid == me();
    }
  }
}
